{
  "name": "pi-workfeed",
  "version": "0.4.5",
  "description": "Workflow telemetry for pi: todo tracking with per-item timing, plus an event log that ties tasks, turns, tool calls and tokens to one join key",
  "keywords": [
    "pi-package",
    "pi",
    "workflow",
    "telemetry",
    "observability",
    "logging",
    "timing",
    "todo"
  ],
  "license": "MIT",
  "type": "module",
  "author": "Wren-Xin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Wren-Xin/pi-workfeed.git"
  },
  "files": [
    "extensions",
    "skills",
    "docs",
    "schemas",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --experimental-strip-types test/run.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./extensions/todo/index.ts",
      "./extensions/journal/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  }
}
